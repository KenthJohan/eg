{
	"id": "EgUi_test",
	"type": "application",
	"value": {
		"description": "Test project for EgUi",
		"public": false,
		"use": [
			"EgUi",
			"EgSpatials",
			"EgShapes",
			"flecs"
		]
	},
	"test": {
		"testsuites": [{
			"id": "FlowLayout",
			"setup": true,
			"teardown": true,
			"testcases": [
				"test_children_flow_right_then_wrap_down",
				"test_none_direction_leaves_children_untouched"
			]
		}, {
			"id": "TableLayout",
			"setup": true,
			"teardown": true,
			"testcases": [
				"test_cells_size_to_largest_child_and_position",
				"test_empty_table_has_no_space",
				"test_sparse_cells_leave_empty_columns",
				"test_relayout_after_child_resize"
			]
		}]
	},
	"lang.c": {
		"lib": [
			"EgUi",
			"EgSpatials",
			"EgShapes",
			"flecs",
			"m"
		]
	}
